{
  "name": "mue",
  "productName": "Mue",
  "version": "1.2.0",
  "description": "Convertir et alléger images, PDF et vidéos sur Mac",
  "author": "Cyril Caron",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/CyrilCaron/Mue-Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyrilCaron/Mue-Software.git"
  },
  "bugs": {
    "url": "https://github.com/CyrilCaron/Mue-Software/issues"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:native && electron .",
    "test": "node test/engine.test.js",
    "dist": "npm run build:native && electron-builder --mac",
    "build:native": "mkdir -p build/native && swiftc -O -sdk $(xcrun --show-sdk-path --sdk macosx15.5 2>/dev/null || xcrun --show-sdk-path) -target arm64-apple-macos12 native/pdfkit.swift -o build/native/mue-pdfkit"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.3.289"
  },
  "build": {
    "appId": "fr.cyril.mue",
    "productName": "Mue",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "build/native",
        "to": "native"
      }
    ]
  }
}
